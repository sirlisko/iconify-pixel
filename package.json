{
  "name": "iconify-pixel",
  "version": "0.1.0",
  "description": "Redraw any Iconify icon as a crisp pixel-art sprite",
  "type": "module",
  "license": "MIT",
  "author": "Luca Lischetti <luca@sirlisko.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirlisko/iconify-pixel.git"
  },
  "homepage": "https://github.com/sirlisko/iconify-pixel#readme",
  "bugs": "https://github.com/sirlisko/iconify-pixel/issues",
  "keywords": [
    "iconify",
    "icons",
    "pixel-art",
    "svg",
    "lucide",
    "tabler",
    "sprite"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sheet": "tsx scripts/contact-sheet.ts",
    "parity": "tsx scripts/parity.ts"
  },
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.141",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.42",
    "@types/node": "^26.6.4",
    "lucide": "^1.53.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
